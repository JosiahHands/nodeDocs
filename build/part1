}

buf.copy(buf, 0, 4, 10);

console.log(buf.toString());
// Prints: efghijghijklmnopqrstuvwxyz</code></pre><p class="codeend">End of code.</p><p class="codelabel">CommonJS version:</p><pre><code>const { Buffer } = require('node:buffer');

