channels.asyncStart.bindStore(myStore, (data) => {
  return data.span;
});</code></pre><p class="codeend">End of code.</p></div></section>
<section><h4 id="tracingchannelhassubscribers"><code>tracingChannel.hasSubscribers</code><a id="diagnostics_channel_tracingchannel_hassubscribers"></a></h4><div class="api_metadata">Added in: v22.0.0, v20.13.0</div><ul>
