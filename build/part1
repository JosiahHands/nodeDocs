});

console.log(myEmitter.listeners('event'));

myEmitter.emit('event', 1, 2, 3, 4, 5);

// Prints:
// [
//   [Function: firstListener],
//   [Function: secondListener],
//   [Function: thirdListener]
// ]
// Helloooo! first listener
// event with parameters 1, 2 in second listener
// event with parameters 1, 2, 3, 4, 5 in third listener</code></pre><p class="codeend">End of code.</p></div></section>
<section><h3 id="emittereventnames"><code>emitter.eventNames()</code><a id="events_emitter_eventnames"></a></h3><div class="api_metadata">Added in: v6.0.0</div><ul>
<li>Returns: <a href="https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type">string</a>[] or <a href="https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#symbol_type">symbol</a>[]</li>
